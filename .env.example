# Contentful — Settings › API keys in the Contentful web app.
# Copy to `.env` (gitignored) and fill in. The build fails with a named
# error if a required variable is missing.
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
# Optional: lets `pnpm dev` show draft/unpublished entries.
CONTENTFUL_PREVIEW_TOKEN=
# Optional: defaults to "master".
CONTENTFUL_ENVIRONMENT=master
